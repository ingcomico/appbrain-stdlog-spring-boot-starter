{
  "@timestamp": { "$resolver": "timestamp" },
  "level": { "$resolver": "level", "field": "name" },
  "stdlog": { "$resolver": "message", "stringified": false },
  "request_id": { "$resolver": "mdc", "key": "request_id" },
  "operation": { "$resolver": "mdc", "key": "operation" },
  "traceId": { "$resolver": "mdc", "key": "traceId" },
  "spanId": { "$resolver": "mdc", "key": "spanId" },
  "stack_trace": { "$resolver": "exception", "field": "stackTrace", "stackTrace": { "stringified": true } },
  "stdlog_lib_version": "${stdlog.libVersion:-unknown}"
}
