<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuracion equivalente a stdlog/logback-spring-stdlog.xml para consumidores sobre Log4j2
  (ADR-0014). Produce el mismo objeto JSON bajo la clave `stdlog`.

  Uso en el consumidor:
    logging.config: classpath:stdlog/log4j2-stdlog.xml

  El payload llega como ObjectMessage desde Log4j2EventWriter, y el resolver `message` con
  stringified=false lo expande como objeto anidado en vez de como cadena escapada.
-->
<Configuration status="WARN">
  <Appenders>
    <Console name="JSON" target="SYSTEM_OUT">
      <JsonTemplateLayout eventTemplateUri="classpath:stdlog/log4j2-stdlog-template.json"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="stdlog" level="INFO" additivity="false">
      <AppenderRef ref="JSON"/>
    </Logger>
    <Root level="INFO">
      <AppenderRef ref="JSON"/>
    </Root>
  </Loggers>
</Configuration>
