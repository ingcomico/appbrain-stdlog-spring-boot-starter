<configuration>
    <springProperty scope="context"
                    name="STDLOG_LIB_VERSION"
                    source="stdlog.libVersion"
                    defaultValue="unknown"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <logLevel/>
                <timestamp/>
                <!--threadName/-->
                <logstashMarkers/>
                <message/>
                <!--pattern>
                    { "message": "%replace(%message){'^stdlog$',''}" }
                </pattern-->
                <!--loggerName/-->
                <!-- <mdc> ... </mdc> -->
                <pattern>
                    <pattern>{"stdlog_lib_version":"${STDLOG_LIB_VERSION}"}</pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>200</maxDepthPerThrowable>
                        <maxLength>30000</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <logger name="stdlog" level="INFO" additivity="false">
        <appender-ref ref="JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
