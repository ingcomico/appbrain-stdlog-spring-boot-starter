<configuration>
    <springProperty scope="context"
                    name="STDLOG_LIB_VERSION"
                    source="stdlog.libVersion"
                    defaultValue="unknown"/>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <logLevel/>
                <timestamp/>
                <!--threadName/-->
                <logstashMarkers/>
                <message/>
                <!--pattern>
                    { "message": "%replace(%message){'^stdlog$',''}" }
                </pattern-->
                <!--loggerName/-->
                <!-- Correlacion en TODA linea de log, no solo en los eventos stdlog (auditoria F-11).
                     Sin esto se puede filtrar por request_id los eventos de la libreria, pero no las
                     lineas que escribe el codigo de la aplicacion en ese mismo request, que suele ser
                     lo primero que hace falta al depurar.
                     Se excluye stdlog.excluded: es un marcador interno de la politica de exclusion
                     (ver StdlogEmitter), no informacion util para el consumidor. -->
                <mdc>
                    <excludeMdcKeyName>stdlog.excluded</excludeMdcKeyName>
                </mdc>
                <pattern>
                    <pattern>{"stdlog_lib_version":"${STDLOG_LIB_VERSION}"}</pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                    <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                        <maxDepthPerThrowable>200</maxDepthPerThrowable>
                        <maxLength>30000</maxLength>
                        <rootCauseFirst>true</rootCauseFirst>
                    </throwableConverter>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <logger name="stdlog" level="INFO" additivity="false">
        <appender-ref ref="JSON"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
